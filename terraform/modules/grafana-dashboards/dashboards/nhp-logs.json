{
  "uid": "nhp-logs-${environment}",
  "title": "NHP Logs",
  "description": "NHP server and AC log aggregation via CloudWatch Logs Insights",
  "tags": ["nhp", "logs", "${environment}"],
  "timezone": "browser",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [
    {
      "title": "NHP Infrastructure",
      "type": "link",
      "url": "/d/nhp-infrastructure-${environment}/nhp-infrastructure?var-environment=${environment}",
      "icon": "dashboard"
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Log Volume",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Server Log Volume",
      "description": "NHP Server log lines per minute",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
      "datasource": { "type": "cloudwatch", "uid": "${cloudwatch_uid}" },
      "targets": [
        {
          "refId": "A",
          "queryMode": "Logs",
          "logGroupNames": ["${server_log_group}"],
          "expression": "fields @timestamp, @message\n| stats count(*) as log_lines by bin(1m)",
          "region": "default",
          "statsGroups": ["bin(1m)"],
          "namespace": "",
          "id": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 50,
            "stacking": { "mode": "normal" }
          },
          "unit": "short"
        }
      },
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": { "displayMode": "table", "calcs": ["sum", "mean"] }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "AC Log Volume",
      "description": "NHP AC log lines per minute by stream type (ac, firewall, traefik)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 1 },
      "datasource": { "type": "cloudwatch", "uid": "${cloudwatch_uid}" },
      "targets": [
        {
          "refId": "A",
          "queryMode": "Logs",
          "logGroupNames": ["${ac_log_group}"],
          "expression": "fields @timestamp, @logStream\n| parse @logStream \"*/*\" as instance_id, stream_type\n| stats count(*) as log_lines by stream_type, bin(1m)",
          "region": "default",
          "statsGroups": ["stream_type", "bin(1m)"],
          "namespace": "",
          "id": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 50,
            "stacking": { "mode": "normal" }
          },
          "unit": "short"
        }
      },
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": { "displayMode": "table", "calcs": ["sum", "mean"] }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Error Log Rate",
      "description": "Log lines containing ERROR or FATAL across server and AC",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 9 },
      "datasource": { "type": "cloudwatch", "uid": "${cloudwatch_uid}" },
      "targets": [
        {
          "refId": "A",
          "queryMode": "Logs",
          "logGroupNames": ["${server_log_group}", "${ac_log_group}"],
          "expression": "fields @timestamp, @message, @logStream\n| filter @message like /(?i)(ERROR|FATAL)/\n| stats count(*) as errors by bin(1m)",
          "region": "default",
          "statsGroups": ["bin(1m)"],
          "namespace": "",
          "id": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 20
          },
          "color": { "mode": "palette-classic" },
          "unit": "short"
        }
      },
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": { "displayMode": "table", "calcs": ["sum", "max"] }
      }
    },
    {
      "id": 5,
      "type": "row",
      "title": "NHP Server Logs",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 17 },
      "collapsed": false
    },
    {
      "id": 6,
      "type": "logs",
      "title": "Server Logs",
      "description": "NHP server log stream",
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 18 },
      "datasource": { "type": "cloudwatch", "uid": "${cloudwatch_uid}" },
      "targets": [
        {
          "refId": "A",
          "queryMode": "Logs",
          "logGroupNames": ["${server_log_group}"],
          "expression": "fields @timestamp, @message, @logStream\n| sort @timestamp desc\n| limit 200",
          "region": "default",
          "statsGroups": [],
          "namespace": "",
          "id": ""
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": true,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "enableLogDetails": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none"
      }
    },
    {
      "id": 7,
      "type": "row",
      "title": "Access Controller Logs",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 30 },
      "collapsed": false
    },
    {
      "id": 8,
      "type": "logs",
      "title": "AC Logs",
      "description": "NHP Access Controller log stream",
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 31 },
      "datasource": { "type": "cloudwatch", "uid": "${cloudwatch_uid}" },
      "targets": [
        {
          "refId": "A",
          "queryMode": "Logs",
          "logGroupNames": ["${ac_log_group}"],
          "expression": "fields @timestamp, @message, @logStream\n| filter @logStream like /\\/ac$/\n| sort @timestamp desc\n| limit 200",
          "region": "default",
          "statsGroups": [],
          "namespace": "",
          "id": ""
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": true,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "enableLogDetails": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none"
      }
    },
    {
      "id": 9,
      "type": "row",
      "title": "NHP Firewall Logs",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 43 },
      "collapsed": true,
      "panels": [
        {
          "id": 10,
          "type": "timeseries",
          "title": "Firewall Actions",
          "description": "NHP-ACCEPT, NHP-DENY, and NHP-FORWARD events from iptables logging",
          "gridPos": { "h": 8, "w": 24, "x": 0, "y": 44 },
          "datasource": { "type": "cloudwatch", "uid": "${cloudwatch_uid}" },
          "targets": [
            {
              "refId": "A",
              "queryMode": "Logs",
              "logGroupNames": ["${ac_log_group}"],
              "expression": "fields @timestamp, @message, @logStream\n| filter @logStream like /nhp-(accept|deny|forward)/\n| parse @logStream \"*/*\" as instance_id, action\n| stats count(*) as events by action, bin(1m)",
              "region": "default",
              "statsGroups": ["action", "bin(1m)"],
              "namespace": "",
              "id": ""
            }
          ],
          "fieldConfig": {
            "defaults": {
              "custom": {
                "drawStyle": "bars",
                "fillOpacity": 50,
                "stacking": { "mode": "normal" }
              },
              "unit": "short"
            }
          }
        },
        {
          "id": 11,
          "type": "logs",
          "title": "Firewall Deny Log",
          "description": "All NHP-DENY events (unauthorized access attempts)",
          "gridPos": { "h": 10, "w": 24, "x": 0, "y": 52 },
          "datasource": { "type": "cloudwatch", "uid": "${cloudwatch_uid}" },
          "targets": [
            {
              "refId": "A",
              "queryMode": "Logs",
              "logGroupNames": ["${ac_log_group}"],
              "expression": "fields @timestamp, @message\n| filter @logStream like /nhp-deny/\n| sort @timestamp desc\n| limit 200",
              "region": "default",
              "statsGroups": [],
              "namespace": "",
              "id": ""
            }
          ],
          "options": {
            "showTime": true,
            "showLabels": true,
            "wrapLogMessage": true,
            "enableLogDetails": true,
            "sortOrder": "Descending"
          }
        },
        {
          "id": 12,
          "type": "logs",
          "title": "Traefik Access Log",
          "description": "Traefik reverse proxy access logs (HTTP requests to protected resources)",
          "gridPos": { "h": 10, "w": 24, "x": 0, "y": 62 },
          "datasource": { "type": "cloudwatch", "uid": "${cloudwatch_uid}" },
          "targets": [
            {
              "refId": "A",
              "queryMode": "Logs",
              "logGroupNames": ["${ac_log_group}"],
              "expression": "fields @timestamp, @message\n| filter @logStream like /traefik-access/\n| sort @timestamp desc\n| limit 200",
              "region": "default",
              "statsGroups": [],
              "namespace": "",
              "id": ""
            }
          ],
          "options": {
            "showTime": true,
            "showLabels": true,
            "wrapLogMessage": true,
            "enableLogDetails": true,
            "sortOrder": "Descending"
          }
        }
      ]
    }
  ],
  "templating": {
    "list": [
      {
        "name": "environment",
        "type": "constant",
        "current": { "value": "${environment}" },
        "hide": 2
      }
    ]
  },
  "time": { "from": "now-1h", "to": "now" },
  "refresh": "30s",
  "schemaVersion": 39
}
