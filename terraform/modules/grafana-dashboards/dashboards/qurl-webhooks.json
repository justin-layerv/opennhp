{
  "title": "QURL Webhooks",
  "description": "Webhook delivery metrics and health for QURL service",
  "uid": "qurl-webhooks",
  "tags": [
    "qurl",
    "webhooks"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "annotations": {
    "list": [
      {
        "name": "Deployments",
        "datasource": {
          "uid": "${datasource_uid}"
        },
        "enable": true,
        "hide": false,
        "iconColor": "blue",
        "expr": "changes(target_info{service_name=\"qurl-api\", deployment_environment=\"$environment\"}[2m]) > 0",
        "step": "60s",
        "titleFormat": "Deployment",
        "textFormat": "Service restarted"
      }
    ]
  },
  "links": [
    {
      "title": "Operations",
      "type": "link",
      "url": "/d/qurl-operations/qurl-operations?var-environment=$environment&var-cell_id=$cell_id",
      "icon": "dashboard"
    },
    {
      "title": "Business Metrics",
      "type": "link",
      "url": "/d/qurl-business/qurl-business-metrics?var-environment=$environment&var-cell_id=$cell_id",
      "icon": "dashboard"
    }
  ],
  "templating": {
    "list": [
      {
        "name": "environment",
        "type": "custom",
        "current": {
          "text": "${environment}",
          "value": "${environment}"
        },
        "options": [
          {
            "text": "sandbox",
            "value": "sandbox"
          },
          {
            "text": "prod",
            "value": "prod"
          }
        ]
      },
      {
        "name": "cell_id",
        "type": "query",
        "datasource": {
          "uid": "${datasource_uid}"
        },
        "query": "label_values(qurl_webhook_delivery_total{service_name=\"qurl-api\"}, cell_id)",
        "refresh": 2,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "text": ["All"],
          "value": ["$__all"]
        }
      }
    ]
  },
  "panels": [
    {
      "id": 100,
      "title": "Overview",
      "type": "row",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "collapsed": false
    },
    {
      "id": 1,
      "title": "Delivery Success Rate (1h)",
      "description": "Percentage of successful webhook deliveries over the last hour. Action: If < 99%, investigate failed deliveries in the Retries & Failures section.",
      "type": "gauge",
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "datasource": {
        "uid": "${datasource_uid}"
      },
      "targets": [
        {
          "expr": "sum(rate(qurl_webhook_delivery_total{service_name=\"qurl-api\", deployment_environment=\"$environment\", cell_id=~\"$cell_id\", status=\"success\"}[1h])) / sum(rate(qurl_webhook_delivery_total{service_name=\"qurl-api\", deployment_environment=\"$environment\", cell_id=~\"$cell_id\"}[1h])) * 100 or vector(100)",
          "legendFormat": "Success %"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 90
              },
              {
                "color": "green",
                "value": 99
              }
            ]
          }
        }
      }
    },
    {
      "id": 2,
      "title": "Deliveries (1h)",
      "description": "Total webhook delivery attempts in the last hour. Action: If zero when traffic is expected, check webhook event emission.",
      "type": "stat",
      "gridPos": {
        "h": 3,
        "w": 3,
        "x": 6,
        "y": 1
      },
      "datasource": {
        "uid": "${datasource_uid}"
      },
      "targets": [
        {
          "expr": "sum(increase(qurl_webhook_delivery_total{service_name=\"qurl-api\", deployment_environment=\"$environment\", cell_id=~\"$cell_id\"}[1h]))",
          "legendFormat": "Total"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        }
      }
    },
    {
      "id": 3,
      "title": "Successful (1h)",
      "description": "Successful webhook deliveries in the last hour. Action: Compare with total deliveries to spot success rate trends.",
      "type": "stat",
      "gridPos": {
        "h": 3,
        "w": 3,
        "x": 9,
        "y": 1
      },
      "datasource": {
        "uid": "${datasource_uid}"
      },
      "targets": [
        {
          "expr": "sum(increase(qurl_webhook_delivery_total{service_name=\"qurl-api\", deployment_environment=\"$environment\", cell_id=~\"$cell_id\", status=\"success\"}[1h]))",
          "legendFormat": "Success"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        }
      }
    },
    {
      "id": 4,
      "title": "Failed (1h)",
      "description": "Failed webhook deliveries in the last hour. Action: If > 0, check Failure Reasons panel for error breakdown.",
      "type": "stat",
      "gridPos": {
        "h": 3,
        "w": 3,
        "x": 6,
        "y": 4
      },
      "datasource": {
        "uid": "${datasource_uid}"
      },
      "targets": [
        {
          "expr": "sum(increase(qurl_webhook_delivery_total{service_name=\"qurl-api\", deployment_environment=\"$environment\", cell_id=~\"$cell_id\", status=\"failed\"}[1h]))",
          "legendFormat": "Failed"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "red",
                "value": 10
              }
            ]
          }
        }
      }
    },
    {
      "id": 5,
      "title": "Retrying",
      "description": "Currently pending retry deliveries. Action: If consistently > 20, check destination health and retry backoff configuration.",
      "type": "stat",
      "gridPos": {
        "h": 3,
        "w": 3,
        "x": 9,
        "y": 4
      },
      "datasource": {
        "uid": "${datasource_uid}"
      },
      "targets": [
        {
          "expr": "clamp_min(sum(qurl_webhook_delivery_pending{service_name=\"qurl-api\", deployment_environment=\"$environment\", cell_id=~\"$cell_id\"}), 0) or vector(0)",
          "legendFormat": "Pending"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 5
              },
              {
                "color": "orange",
                "value": 20
              }
            ]
          }
        }
      }
    },
    {
      "id": 6,
      "title": "p999 Latency",
      "description": "99.9th percentile webhook delivery latency. Action: If > 10s, check destination endpoint health and retry configuration.",
      "type": "stat",
      "gridPos": {
        "h": 6,
        "w": 4,
        "x": 12,
        "y": 1
      },
      "datasource": {
        "uid": "${datasource_uid}"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.999, sum(rate(qurl_webhook_delivery_duration_seconds_bucket{service_name=\"qurl-api\", deployment_environment=\"$environment\", cell_id=~\"$cell_id\"}[5m])) by (le)) * 1000",
          "legendFormat": "p999"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 2000
              },
              {
                "color": "red",
                "value": 10000
              }
            ]
          }
        }
      }
    },
    {
      "id": 7,
      "title": "Active Webhooks",
      "description": "Number of currently active webhook subscriptions. Action: If unexpectedly zero, check webhook registration service.",
      "type": "stat",
      "gridPos": {
        "h": 3,
        "w": 4,
        "x": 16,
        "y": 1
      },
      "datasource": {
        "uid": "${datasource_uid}"
      },
      "targets": [
        {
          "expr": "clamp_min(sum(qurl_webhook_active{service_name=\"qurl-api\", deployment_environment=\"$environment\", cell_id=~\"$cell_id\"}), 0)",
          "legendFormat": "Active"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        }
      }
    },
    {
      "id": 8,
      "title": "Disabled Webhooks",
      "description": "Number of disabled webhook subscriptions. Action: If increasing, check Webhook Health section for consecutive failure patterns.",
      "type": "stat",
      "gridPos": {
        "h": 3,
        "w": 4,
        "x": 16,
        "y": 4
      },
      "datasource": {
        "uid": "${datasource_uid}"
      },
      "targets": [
        {
          "expr": "clamp_min(sum(qurl_webhook_disabled{service_name=\"qurl-api\", deployment_environment=\"$environment\", cell_id=~\"$cell_id\"}), 0)",
          "legendFormat": "Disabled"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "orange",
                "value": 5
              }
            ]
          }
        }
      }
    },
    {
      "id": 9,
      "title": "Event Queue Depth",
      "description": "Current number of webhook events waiting in the delivery queue. Action: If > 500, check for processing bottlenecks or stalled consumers.",
      "type": "stat",
      "gridPos": {
        "h": 3,
        "w": 4,
        "x": 20,
        "y": 1
      },
      "datasource": {
        "uid": "${datasource_uid}"
      },
      "targets": [
        {
          "expr": "sum(qurl_webhook_queue_depth{service_name=\"qurl-api\", deployment_environment=\"$environment\", cell_id=~\"$cell_id\"})",
          "legendFormat": "Queue"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 100
              },
              {
                "color": "red",
                "value": 500
              }
            ]
          }
        }
      }
    },
    {
      "id": 60,
      "title": "DLQ Depth",
      "description": "Webhook deliveries that exhausted all retries (abandoned). Action: If increasing, destinations may be persistently unreachable.",
      "type": "stat",
      "gridPos": {
        "h": 3,
        "w": 4,
        "x": 20,
        "y": 4
      },
      "datasource": {
        "uid": "${datasource_uid}"
      },
      "targets": [
        {
          "expr": "sum(qurl_webhook_dlq_total{service_name=\"qurl-api\", deployment_environment=\"$environment\", cell_id=~\"$cell_id\"}) or vector(0)",
          "legendFormat": "DLQ"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 5
              },
              {
                "color": "red",
                "value": 20
              }
            ]
          }
        }
      }
    },
    {
      "id": 101,
      "title": "Delivery Performance",
      "type": "row",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 7
      },
      "collapsed": false
    },
    {
      "id": 10,
      "title": "Delivery Rate by Status",
      "description": "Webhook delivery rate over time broken down by status. Action: If failed rate spikes, correlate with deployment annotations and check destination health.",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "datasource": {
        "uid": "${datasource_uid}"
      },
      "targets": [
        {
          "expr": "sum by (status) (rate(qurl_webhook_delivery_total{service_name=\"qurl-api\", deployment_environment=\"$environment\", cell_id=~\"$cell_id\"}[5m]))",
          "legendFormat": "{{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 20
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "success"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "green",
                  "mode": "fixed"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "failed"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "red",
                  "mode": "fixed"
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": 11,
      "title": "Delivery Latency",
      "description": "Webhook delivery latency percentiles over time. Action: If p99/p999 diverge significantly from p50, investigate slow outlier destinations.",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "datasource": {
        "uid": "${datasource_uid}"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(qurl_webhook_delivery_duration_seconds_bucket{service_name=\"qurl-api\", deployment_environment=\"$environment\", cell_id=~\"$cell_id\"}[5m])) by (le)) * 1000",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(qurl_webhook_delivery_duration_seconds_bucket{service_name=\"qurl-api\", deployment_environment=\"$environment\", cell_id=~\"$cell_id\"}[5m])) by (le)) * 1000",
          "legendFormat": "p95"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(qurl_webhook_delivery_duration_seconds_bucket{service_name=\"qurl-api\", deployment_environment=\"$environment\", cell_id=~\"$cell_id\"}[5m])) by (le)) * 1000",
          "legendFormat": "p99"
        },
        {
          "expr": "histogram_quantile(0.999, sum(rate(qurl_webhook_delivery_duration_seconds_bucket{service_name=\"qurl-api\", deployment_environment=\"$environment\", cell_id=~\"$cell_id\"}[5m])) by (le)) * 1000",
          "legendFormat": "p999"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 0
          }
        }
      }
    },
    {
      "id": 12,
      "title": "Delivery Latency Heatmap",
      "description": "Distribution of delivery times. Bimodal pattern (fast+slow clusters) suggests mixed destination health.",
      "type": "heatmap",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 16
      },
      "datasource": {
        "uid": "${datasource_uid}"
      },
      "targets": [
        {
          "expr": "sum(increase(qurl_webhook_delivery_duration_seconds_bucket{service_name=\"qurl-api\", deployment_environment=\"$environment\", cell_id=~\"$cell_id\"}[$__rate_interval])) by (le)",
          "legendFormat": "{{le}}",
          "format": "heatmap"
        }
      ],
      "options": {
        "calculate": false,
        "yAxis": {
          "unit": "s"
        },
        "color": {
          "scheme": "Oranges",
          "mode": "scheme"
        },
        "cellGap": 1
      }
    },
    {
      "id": 13,
      "title": "Failure Rate by Event Type",
      "description": "Per-event-type webhook failure rate. Action: If a specific event type has high failure rate, check payload format or destination compatibility.",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "datasource": {
        "uid": "${datasource_uid}"
      },
      "targets": [
        {
          "expr": "sum by (event) (rate(qurl_webhook_delivery_total{service_name=\"qurl-api\", deployment_environment=\"$environment\", cell_id=~\"$cell_id\", status=\"failed\"}[5m])) / sum by (event) (rate(qurl_webhook_delivery_total{service_name=\"qurl-api\", deployment_environment=\"$environment\", cell_id=~\"$cell_id\"}[5m])) * 100",
          "legendFormat": "{{event}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 10
          }
        }
      }
    },
    {
      "id": 14,
      "title": "Queue Depth Over Time",
      "description": "Webhook event queue depth trend. Action: If steadily increasing, consumers may be falling behind. Check for processing errors or resource constraints.",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "datasource": {
        "uid": "${datasource_uid}"
      },
      "targets": [
        {
          "expr": "sum(qurl_webhook_queue_depth{service_name=\"qurl-api\", deployment_environment=\"$environment\", cell_id=~\"$cell_id\"})",
          "legendFormat": "Queue Depth"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 100
              },
              {
                "color": "red",
                "value": 500
              }
            ]
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 20,
            "gradientMode": "scheme"
          }
        }
      }
    },
    {
      "id": 102,
      "title": "Events",
      "type": "row",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 32
      },
      "collapsed": false
    },
    {
      "id": 20,
      "title": "Deliveries by Event Type",
      "description": "Webhook delivery rate broken down by event type. Action: If a specific event type has disproportionate volume, verify it is not generating duplicate events.",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 33
      },
      "datasource": {
        "uid": "${datasource_uid}"
      },
      "targets": [
        {
          "expr": "sum by (event) (rate(qurl_webhook_delivery_total{service_name=\"qurl-api\", deployment_environment=\"$environment\", cell_id=~\"$cell_id\"}[5m]))",
          "legendFormat": "{{event}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 20,
            "stacking": {
              "mode": "normal"
            }
          }
        }
      }
    },
    {
      "id": 21,
      "title": "Event Type Distribution (24h)",
      "description": "Proportion of webhook deliveries by event type over 24 hours. Action: Compare with expected distribution to spot anomalies.",
      "type": "piechart",
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 12,
        "y": 33
      },
      "datasource": {
        "uid": "${datasource_uid}"
      },
      "targets": [
        {
          "expr": "sum by (event) (increase(qurl_webhook_delivery_total{service_name=\"qurl-api\", deployment_environment=\"$environment\", cell_id=~\"$cell_id\"}[24h]))",
          "legendFormat": "{{event}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "values": [
            "value",
            "percent"
          ]
        },
        "pieType": "donut"
      }
    },
    {
      "id": 22,
      "title": "Failure Rate by Event Type",
      "description": "Percentage of failed deliveries per event type over 24 hours. Action: If one event type has significantly higher failure rate, check its payload size and destination compatibility.",
      "type": "table",
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 18,
        "y": 33
      },
      "datasource": {
        "uid": "${datasource_uid}"
      },
      "targets": [
        {
          "expr": "sum by (event) (increase(qurl_webhook_delivery_total{service_name=\"qurl-api\", deployment_environment=\"$environment\", cell_id=~\"$cell_id\", status=\"failed\"}[24h])) / sum by (event) (increase(qurl_webhook_delivery_total{service_name=\"qurl-api\", deployment_environment=\"$environment\", cell_id=~\"$cell_id\"}[24h])) * 100",
          "format": "table",
          "instant": true
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "event": "Event Type",
              "Value": "Failure %"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Failure %"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "gradient"
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "continuous-GrYlRd"
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": 103,
      "title": "Retries & Failures",
      "type": "row",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 41
      },
      "collapsed": false
    },
    {
      "id": 30,
      "title": "Retry Distribution",
      "description": "Retry attempts over time broken down by retry count. Action: If higher retry counts (3+) are increasing, destinations may be persistently unhealthy.",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 42
      },
      "datasource": {
        "uid": "${datasource_uid}"
      },
      "targets": [
        {
          "expr": "sum by (retry_count) (rate(qurl_webhook_retry_total{service_name=\"qurl-api\", deployment_environment=\"$environment\", cell_id=~\"$cell_id\"}[5m]))",
          "legendFormat": "Retry {{retry_count}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "stacking": {
              "mode": "normal"
            }
          }
        }
      }
    },
    {
      "id": 31,
      "title": "Failures by Event Type",
      "description": "Breakdown of failed webhook deliveries by event type over 24 hours.",
      "type": "barchart",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 42
      },
      "datasource": {
        "uid": "${datasource_uid}"
      },
      "targets": [
        {
          "expr": "sum by (event) (increase(qurl_webhook_delivery_total{service_name=\"qurl-api\", deployment_environment=\"$environment\", cell_id=~\"$cell_id\", status=\"failed\"}[24h]))",
          "legendFormat": "{{event}}",
          "format": "table",
          "instant": true
        }
      ],
      "options": {
        "orientation": "horizontal"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          }
        }
      }
    },
    {
      "id": 32,
      "title": "Cumulative Retry Percentage",
      "description": "Percentage of deliveries that required at least one retry. Action: If > 20%, investigate destination reliability or network issues.",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 42
      },
      "datasource": {
        "uid": "${datasource_uid}"
      },
      "targets": [
        {
          "expr": "sum(rate(qurl_webhook_retry_total{service_name=\"qurl-api\", deployment_environment=\"$environment\", cell_id=~\"$cell_id\"}[5m])) / sum(rate(qurl_webhook_delivery_total{service_name=\"qurl-api\", deployment_environment=\"$environment\", cell_id=~\"$cell_id\"}[5m])) * 100",
          "legendFormat": "Retry %"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 10
              },
              {
                "color": "red",
                "value": 20
              }
            ]
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 20,
            "gradientMode": "scheme"
          }
        }
      }
    },
    {
      "id": 33,
      "title": "Delivery Status Distribution",
      "description": "Webhook delivery outcomes over time by status (success, failed, abandoned).",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 50
      },
      "datasource": {
        "uid": "${datasource_uid}"
      },
      "targets": [
        {
          "expr": "sum by (status) (rate(qurl_webhook_delivery_total{service_name=\"qurl-api\", deployment_environment=\"$environment\", cell_id=~\"$cell_id\"}[5m]))",
          "legendFormat": "{{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "^2.."
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "green",
                  "mode": "fixed"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "^4.."
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "yellow",
                  "mode": "fixed"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "^5.."
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "red",
                  "mode": "fixed"
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": 34,
      "title": "Delivery Attempt vs End-to-End Latency",
      "description": "Comparison of individual delivery attempt latency (HTTP call) vs end-to-end latency (including queue time and retries). Action: If end-to-end significantly exceeds attempt latency, queue backlog or retries are adding delay.",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 50
      },
      "datasource": {
        "uid": "${datasource_uid}"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(qurl_webhook_delivery_duration_seconds_bucket{service_name=\"qurl-api\", deployment_environment=\"$environment\", cell_id=~\"$cell_id\"}[5m])) by (le)) * 1000",
          "legendFormat": "p95 Delivery Latency"
        },
        {
          "expr": "histogram_quantile(0.999, sum(rate(qurl_webhook_delivery_duration_seconds_bucket{service_name=\"qurl-api\", deployment_environment=\"$environment\", cell_id=~\"$cell_id\"}[5m])) by (le)) * 1000",
          "legendFormat": "p999 Delivery Latency"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 10
          }
        }
      }
    },
    {
      "id": 61,
      "title": "DLQ Depth Over Time",
      "description": "Cumulative abandoned webhook deliveries over time. A steadily rising trend indicates persistent destination failures.",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 58
      },
      "datasource": {
        "uid": "${datasource_uid}"
      },
      "targets": [
        {
          "expr": "sum(qurl_webhook_dlq_total{service_name=\"qurl-api\", deployment_environment=\"$environment\", cell_id=~\"$cell_id\"}) or vector(0)",
          "legendFormat": "DLQ Depth"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 5
              },
              {
                "color": "red",
                "value": 20
              }
            ]
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 20,
            "gradientMode": "scheme"
          }
        }
      }
    },
    {
      "id": 62,
      "title": "Webhook Staleness (Last Success Age)",
      "description": "Time since last successful delivery per webhook. Webhooks with large ages may have silently broken destinations.",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 58
      },
      "datasource": {
        "uid": "${datasource_uid}"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(qurl_webhook_last_success_age_seconds_bucket{service_name=\"qurl-api\", deployment_environment=\"$environment\", cell_id=~\"$cell_id\"}[5m])) by (le))",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(qurl_webhook_last_success_age_seconds_bucket{service_name=\"qurl-api\", deployment_environment=\"$environment\", cell_id=~\"$cell_id\"}[5m])) by (le))",
          "legendFormat": "p95"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 10
          }
        }
      }
    },
    {
      "id": 104,
      "title": "Webhook Health",
      "type": "row",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 66
      },
      "collapsed": false
    },
    {
      "id": 40,
      "title": "Webhooks with Pending Retries",
      "description": "Webhooks with pending delivery retries. Action: If retries accumulate, check destination endpoint health.",
      "type": "table",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 67
      },
      "datasource": {
        "uid": "${datasource_uid}"
      },
      "targets": [
        {
          "expr": "topk(10, qurl_webhook_delivery_pending{service_name=\"qurl-api\", deployment_environment=\"$environment\", cell_id=~\"$cell_id\"} > 0)",
          "format": "table",
          "instant": true
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "webhook_id": "Webhook ID",
              "owner_id": "Owner",
              "Value": "Consecutive Failures"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Consecutive Failures"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "gradient"
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "continuous-YlOrRd"
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": 41,
      "title": "Currently Disabled Webhooks",
      "description": "Webhooks currently in disabled state. Action: Review and contact webhook owners to fix their endpoints.",
      "type": "table",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 67
      },
      "datasource": {
        "uid": "${datasource_uid}"
      },
      "targets": [
        {
          "expr": "qurl_webhook_disabled{service_name=\"qurl-api\", deployment_environment=\"$environment\", cell_id=~\"$cell_id\"} > 0",
          "format": "table",
          "instant": true
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "owner_id": "Owner",
              "Value": "Count"
            }
          }
        }
      ]
    },
    {
      "id": 105,
      "title": "Webhook Delivery SLO",
      "type": "row",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 75
      },
      "collapsed": true,
      "panels": [
        {
          "id": 50,
          "title": "SLO: Delivered Within 30s",
          "description": "Percentage of webhooks delivered successfully within 30 seconds on the first attempt. SLO target: 99%. Action: If below target, check delivery latency and failure panels.",
          "type": "gauge",
          "gridPos": {
            "h": 8,
            "w": 8,
            "x": 0,
            "y": 76
          },
          "datasource": {
            "uid": "${datasource_uid}"
          },
          "targets": [
            {
              "expr": "(\n  sum(rate(qurl_webhook_delivery_duration_seconds_bucket{service_name=\"qurl-api\", deployment_environment=\"$environment\", cell_id=~\"$cell_id\", le=\"30\"}[1h]))\n  / sum(rate(qurl_webhook_delivery_duration_seconds_count{service_name=\"qurl-api\", deployment_environment=\"$environment\", cell_id=~\"$cell_id\"}[1h]))\n) * 100 or vector(100)",
              "legendFormat": "SLO %"
            }
          ],
          "fieldConfig": {
            "defaults": {
              "unit": "percent",
              "min": 0,
              "max": 100,
              "color": {
                "mode": "thresholds"
              },
              "thresholds": {
                "steps": [
                  {
                    "color": "red",
                    "value": null
                  },
                  {
                    "color": "yellow",
                    "value": 95
                  },
                  {
                    "color": "green",
                    "value": 99
                  }
                ]
              }
            }
          }
        },
        {
          "id": 51,
          "title": "1h Burn Rate",
          "description": "Rate at which the error budget is being consumed over the last hour. Action: If > 1, the SLO will be breached at current pace. Investigate immediately.",
          "type": "stat",
          "gridPos": {
            "h": 8,
            "w": 8,
            "x": 8,
            "y": 76
          },
          "datasource": {
            "uid": "${datasource_uid}"
          },
          "targets": [
            {
              "expr": "(\n  1 - (\n    sum(rate(qurl_webhook_delivery_duration_seconds_bucket{service_name=\"qurl-api\", deployment_environment=\"$environment\", cell_id=~\"$cell_id\", le=\"30\"}[1h]))\n    / sum(rate(qurl_webhook_delivery_duration_seconds_count{service_name=\"qurl-api\", deployment_environment=\"$environment\", cell_id=~\"$cell_id\"}[1h]))\n  )\n) / (1 - 0.99) or vector(0)",
              "legendFormat": "Burn Rate"
            }
          ],
          "fieldConfig": {
            "defaults": {
              "unit": "short",
              "decimals": 2,
              "color": {
                "mode": "thresholds"
              },
              "thresholds": {
                "steps": [
                  {
                    "color": "green",
                    "value": null
                  },
                  {
                    "color": "yellow",
                    "value": 1
                  },
                  {
                    "color": "red",
                    "value": 2
                  }
                ]
              }
            }
          }
        },
        {
          "id": 52,
          "title": "Error Budget Remaining (30d)",
          "description": "Remaining error budget for the 30-day SLO window. Action: If < 50%, reduce risk by pausing non-critical changes. If < 0%, SLO is breached.",
          "type": "gauge",
          "gridPos": {
            "h": 8,
            "w": 8,
            "x": 16,
            "y": 76
          },
          "datasource": {
            "uid": "${datasource_uid}"
          },
          "targets": [
            {
              "expr": "(\n  1 - (\n    (\n      1 - (\n        sum(rate(qurl_webhook_delivery_duration_seconds_bucket{service_name=\"qurl-api\", deployment_environment=\"$environment\", cell_id=~\"$cell_id\", le=\"30\"}[30d]))\n        / sum(rate(qurl_webhook_delivery_duration_seconds_count{service_name=\"qurl-api\", deployment_environment=\"$environment\", cell_id=~\"$cell_id\"}[30d]))\n      )\n    ) / (1 - 0.99)\n  )\n) * 100 or vector(100)",
              "legendFormat": "Budget %"
            }
          ],
          "fieldConfig": {
            "defaults": {
              "unit": "percent",
              "min": 0,
              "max": 100,
              "color": {
                "mode": "thresholds"
              },
              "thresholds": {
                "steps": [
                  {
                    "color": "red",
                    "value": null
                  },
                  {
                    "color": "orange",
                    "value": 25
                  },
                  {
                    "color": "yellow",
                    "value": 50
                  },
                  {
                    "color": "green",
                    "value": 75
                  }
                ]
              }
            }
          }
        }
      ]
    }
  ]
}
