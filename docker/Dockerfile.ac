# Multi-stage build for NHP Access Controller
# Stage 1: Build the NHP AC binary
# Tag participates in the GO_VERSION lockstep (see #1337). Canonical
# source of all locations is .github/workflows/build-and-push.yml's
# env.GO_VERSION block.
FROM golang:1.26.6-bookworm@sha256:116d58cbd88c1297624acc6e967a060012422bacf9930927e23fb719189c6f36 AS builder

WORKDIR /nhp-server

# Install build dependencies
# Local compose exercises the eBPF build/load path, but does not promise
# byte-identical prod objects: prod object freshness remains with
# docker/Dockerfile.ac.aws's pinned clang-18 toolchain and CI guards.
RUN apt-get update && apt-get install -y \
    make \
    clang \
    llvm \
    # libbpf-dev supplies the <bpf/*.h> headers for `make ebpf-objects`;
    # see docker/Dockerfile.ac.aws for the prod-image rationale.
    libbpf-dev \
    && rm -rf /var/lib/apt/lists/*

# Copy source code
COPY . .

RUN echo "Building for architecture: ${TARGETARCH}"

# Build the AC binary plus the eBPF object files.
#
# `init` runs `git clean -df release` first, so it must stay ahead of both
# `acd` and `ebpf-objects`: the latter two populate release/nhp-ac/. The
# runtime stage copies that whole tree to /nhp-ac, and docker-compose mounts
# only individual config files so the image-baked /nhp-ac/etc/*.o files remain
# visible when local FilterMode=EBPFXDP is exercised.
RUN make init acd ebpf-objects

# Stage 2: Runtime image
FROM ubuntu:26.04@sha256:3131b4cc82a783df6c9df078f86e01819a13594b865c2cad47bd1bca2b7063bb AS runtime

# EbpfEngineLoad resolves bpfDir="etc" relative to process cwd, so local
# runtime cwd must match the /nhp-ac tree that carries etc/*.o. This mirrors
# docker/Dockerfile.ac.aws's supervisord `directory=/nhp-ac`.
WORKDIR /nhp-ac

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && \
    apt-get install -y \
    ca-certificates \
    iptables \
    ipset \
    curl \
    # Upgrade libssl3t64 + openssl-provider-legacy to >= 3.5.5-1ubuntu3.2
    # (fixes CVE-2026-45447). See Dockerfile.relay for the rationale (patched
    # base digest is < the docker dep-age window, so we patch the package here).
    libssl3t64 \
    openssl-provider-legacy \
    # Fail the build loudly if the openssl upgrade didn't land — this image is
    # NOT Trivy-scanned in CI, so this assertion is its only CVE-2026-45447 guard.
    && dpkg --compare-versions "$(dpkg-query -W -f='${Version}' libssl3t64)" ge 3.5.5-1ubuntu3.2 \
        || { echo "ERROR: libssl3t64 < 3.5.5-1ubuntu3.2 — CVE-2026-45447 not patched"; exit 1; } \
    && rm -rf /var/lib/apt/lists/* \
    # Drop Canonical's Pebble (unused stray Go binary the ubuntu base ships in
    # /usr/bin/pebble) — it flags HIGH x/net + stdlib CVEs. See Dockerfile.relay
    # and .trivyignore. (This local-dev AC image isn't Trivy-scanned in CI, but
    # we keep it consistent with the scanned Dockerfile.ac.aws.)
    && rm -f /usr/bin/pebble && rm -rf /var/lib/pebble

# Copy built binary and scripts
COPY --from=builder /nhp-server/release/nhp-ac /nhp-ac

# Regression guard: local docker-compose eBPF mode loads these objects from
# /nhp-ac/etc/ at AC startup. Fail the image build if a future edit drops the
# builder's `ebpf-objects` step, changes the Makefile output paths, or emits an
# empty object. Keep this guard in lockstep with docker/Dockerfile.ac.aws via
# scripts/check-ebpf-load-path-lockstep.sh.
RUN test -s /nhp-ac/etc/nhp_ebpf_xdp.o && test -s /nhp-ac/etc/tc_egress.o \
    || { \
        echo "ERROR: eBPF object(s) missing or empty in /nhp-ac/etc/"; \
        echo "local docker-compose AC will boot-fail under FilterMode=EBPFXDP."; \
        echo "Did the builder's 'make ... ebpf-objects' step get dropped,"; \
        echo "did the Makefile EBPF_OBJ_* output paths change, or did the compile emit an empty object?"; \
        echo 'load path: endpoints/ac/ebpf/ebpfegine.go bpfDir="etc"'; \
        exit 1; \
    }

COPY --from=builder /nhp-server/docker/iptables_defaults_ubuntu.sh /iptables_defaults_ubuntu.sh
COPY --from=builder /nhp-server/docker/iptables_defaults_x86.sh /iptables_defaults_x86.sh

# Select appropriate iptables script based on architecture
RUN if [ "$(uname -m)" = "x86_64" ]; then \
        mv /iptables_defaults_x86.sh /iptables_defaults.sh; \
    else \
        mv /iptables_defaults_ubuntu.sh /iptables_defaults.sh; \
    fi && \
    chmod +x /iptables_defaults.sh && \
    rm -f /iptables_defaults_*.sh

COPY --from=builder /nhp-server/docker/start-ac.sh /start.sh
RUN chmod +x /start.sh

ENTRYPOINT ["/start.sh"]
