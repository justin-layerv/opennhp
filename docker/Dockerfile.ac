# Multi-stage build for NHP Access Controller
# Stage 1: Build the NHP AC binary
# Tag participates in the GO_VERSION lockstep (see #1337). Canonical
# source of all locations is .github/workflows/build-and-push.yml's
# env.GO_VERSION block.
FROM golang:1.26.4-bookworm@sha256:5d2b868674b57c9e48cdd39e891acce4196b6926ca6d11e9c270a8f85106203d AS builder

WORKDIR /nhp-server

# Install build dependencies
RUN apt-get update && apt-get install -y \
    make \
    clang \
    llvm \
    && rm -rf /var/lib/apt/lists/*

# Copy source code
COPY . .

RUN echo "Building for architecture: ${TARGETARCH}"

# Build the AC
RUN make init acd

# Stage 2: Runtime image
FROM ubuntu:26.04@sha256:f3d28607ddd78734bb7f71f117f3c6706c666b8b76cbff7c9ff6e5718d46ff64 AS runtime

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && \
    apt-get install -y \
    ca-certificates \
    iptables \
    ipset \
    curl \
    # Upgrade libssl3t64 + openssl-provider-legacy to >= 3.5.5-1ubuntu3.2
    # (fixes CVE-2026-45447). See Dockerfile.relay for the rationale (patched
    # base digest is < the docker dep-age window, so we patch the package here).
    libssl3t64 \
    openssl-provider-legacy \
    # Fail the build loudly if the openssl upgrade didn't land — this image is
    # NOT Trivy-scanned in CI, so this assertion is its only CVE-2026-45447 guard.
    && dpkg --compare-versions "$(dpkg-query -W -f='${Version}' libssl3t64)" ge 3.5.5-1ubuntu3.2 \
        || { echo "ERROR: libssl3t64 < 3.5.5-1ubuntu3.2 — CVE-2026-45447 not patched"; exit 1; } \
    && rm -rf /var/lib/apt/lists/* \
    # Drop Canonical's Pebble (unused stray Go binary the ubuntu base ships in
    # /usr/bin/pebble) — it flags HIGH x/net + stdlib CVEs. See Dockerfile.relay
    # and .trivyignore. (This local-dev AC image isn't Trivy-scanned in CI, but
    # we keep it consistent with the scanned Dockerfile.ac.aws.)
    && rm -f /usr/bin/pebble && rm -rf /var/lib/pebble

# Copy built binary and scripts
COPY --from=builder /nhp-server/release/nhp-ac /nhp-ac
COPY --from=builder /nhp-server/docker/iptables_defaults_ubuntu.sh /iptables_defaults_ubuntu.sh
COPY --from=builder /nhp-server/docker/iptables_defaults_x86.sh /iptables_defaults_x86.sh

# Select appropriate iptables script based on architecture
RUN if [ "$(uname -m)" = "x86_64" ]; then \
        mv /iptables_defaults_x86.sh /iptables_defaults.sh; \
    else \
        mv /iptables_defaults_ubuntu.sh /iptables_defaults.sh; \
    fi && \
    chmod +x /iptables_defaults.sh && \
    rm -f /iptables_defaults_*.sh

# Create startup script
RUN echo '#!/bin/bash\n/iptables_defaults.sh -f\nexec /nhp-ac/nhp-acd run' > /start.sh && \
    chmod +x /start.sh

ENTRYPOINT ["/start.sh"]
