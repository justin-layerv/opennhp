# Multi-stage build for NHP Server
# Stage 1: Build the NHP server binary
FROM golang:1.24-bookworm AS builder

WORKDIR /nhp-server

# Install build dependencies
RUN apt-get update && apt-get install -y \
    make \
    clang \
    llvm \
    && rm -rf /var/lib/apt/lists/*

# Copy source code
COPY . .

# Build the server
RUN make init serverd plugins

# Stage 2: Runtime image
FROM ubuntu:22.04 AS runtime

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && \
    apt-get install -y \
    ca-certificates \
    iptables \
    ipset \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy built binary
COPY --from=builder /nhp-server/release/nhp-server /nhp-server

# Run as non-root user (optional, requires NET_ADMIN capability)
# RUN useradd -r -s /bin/false nhp
# USER nhp

ENTRYPOINT ["/nhp-server/nhp-serverd"]
CMD ["run"]
