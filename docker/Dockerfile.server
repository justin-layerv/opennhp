# Multi-stage build for NHP Server
# Stage 1: Build the NHP server binary
# Tag participates in the GO_VERSION lockstep (see #1337). Canonical
# source of all locations is .github/workflows/build-and-push.yml's
# env.GO_VERSION block.
FROM golang:1.26.4-bookworm@sha256:5d2b868674b57c9e48cdd39e891acce4196b6926ca6d11e9c270a8f85106203d AS builder

WORKDIR /nhp-server

# Install build dependencies (minimal - no CGO needed).
# -o Acquire::Retries=3 + short timeout so a transient APT mirror
# outage retries instead of failing the Docker build. This stage hits
# deb.debian.org (golang:bookworm base); the runtime stage's
# ubuntu:24.04 apt calls apply the same hardening. See Dockerfile.ac.aws
# for the CI-flake instance (run 24548987311) that motivated this.
RUN apt-get -o Acquire::Retries=3 -o Acquire::http::Timeout=30 -o Acquire::https::Timeout=30 update && \
    apt-get -o Acquire::Retries=3 -o Acquire::http::Timeout=30 -o Acquire::https::Timeout=30 install -y \
    make \
    && rm -rf /var/lib/apt/lists/*

# Copy dependency files first (better layer caching)
COPY nhp/go.mod nhp/go.sum ./nhp/
# internalauth/ has no go.sum today (pure-stdlib module). When the
# first non-stdlib dep lands, ALSO add `internalauth/go.sum` to
# this COPY — without it, the dep-prefetch layer will succeed via
# go.mod resolution but layer caching will silently drift from the
# actual build (downloads stay reproducible but the cache layer
# stops invalidating on dep-version bumps). Same caveat tracked in
# codeql.yml + dependabot-go-tidy.yml setup-go cache blocks.
COPY internalauth/go.mod ./internalauth/
COPY endpoints/go.mod endpoints/go.sum ./endpoints/

# Download dependencies (cached unless go.mod/go.sum change)
RUN cd nhp && go mod download
RUN cd endpoints && go mod download

# Copy source code
COPY . .

RUN echo "Building for architecture: ${TARGETARCH}"

# Build the server with CGO disabled
# Plugins are now statically compiled into the server binary
ENV CGO_ENABLED=0
RUN make init serverd

# Stage 2: Runtime image
FROM ubuntu:26.04@sha256:f3d28607ddd78734bb7f71f117f3c6706c666b8b76cbff7c9ff6e5718d46ff64 AS runtime

ENV DEBIAN_FRONTEND=noninteractive
# Swap to Canonical's Azure mirror — GitHub Actions runners are in Azure,
# so azure.archive.ubuntu.com is geo-local and more reliable than the
# general archive.ubuntu.com. See Dockerfile.ac.aws for the CI-failure
# history (2026-04-17 outage affecting runs 24548987311 / 24549340621 /
# 24550346283) that motivated this swap.
RUN sed -i 's|//archive.ubuntu.com|//azure.archive.ubuntu.com|g; s|//security.ubuntu.com|//azure.archive.ubuntu.com|g' /etc/apt/sources.list.d/ubuntu.sources && \
    grep -q azure.archive.ubuntu.com /etc/apt/sources.list.d/ubuntu.sources || \
        { echo "ERROR: ubuntu.sources mirror substitution failed — file format may have changed"; exit 1; } && \
    apt-get -o Acquire::Retries=3 -o Acquire::http::Timeout=30 -o Acquire::https::Timeout=30 update && \
    apt-get -o Acquire::Retries=3 -o Acquire::http::Timeout=30 -o Acquire::https::Timeout=30 install -y \
    ca-certificates \
    iptables \
    ipset \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy built binary
COPY --from=builder /nhp-server/release/nhp-server /nhp-server

# Copy templates for plugins (passcode login pages, etc.)
COPY docker/nhp-server/templates /nhp-server/templates

# Health check using liveness endpoint (port 8888 is HTTP listener)
# Checks every 30s, allow 60s startup, 3 retries before unhealthy
HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:8888/health/live || exit 1

# Run as non-root user (optional, requires NET_ADMIN capability)
# RUN useradd -r -s /bin/false nhp
# USER nhp

ENTRYPOINT ["/nhp-server/nhp-serverd"]
CMD ["run"]
