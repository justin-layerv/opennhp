# Multi-stage build for NHP Server
# Stage 1: Build the NHP server binary
ARG GO_VERSION=1.24
FROM golang:${GO_VERSION}-bookworm AS builder

WORKDIR /nhp-server

# Install build dependencies
RUN apt-get update && apt-get install -y \
    make \
    clang \
    llvm \
    && rm -rf /var/lib/apt/lists/*

# Copy dependency files first (better layer caching)
COPY nhp/go.mod nhp/go.sum ./nhp/
COPY endpoints/go.mod endpoints/go.sum ./endpoints/

# Download dependencies (cached unless go.mod/go.sum change)
RUN cd nhp && go mod download
RUN cd endpoints && go mod download

# Copy source code
COPY . .

RUN echo "Building for architecture: ${TARGETARCH}"

# Build the server with CGO enabled (required for plugin compatibility)
# Both server and plugins MUST be built with the same CGO setting
RUN CGO_ENABLED=1 make init serverd plugins

# Build external plugins (same Go environment guarantees compatibility)
# Clone and build passcode plugin
# Uses BuildKit secret mount - token never stored in image layers
RUN --mount=type=secret,id=github_token \
    GITHUB_TOKEN=$(cat /run/secrets/github_token 2>/dev/null || echo "") && \
    if [ -n "$GITHUB_TOKEN" ]; then \
      git config --global url."https://x-access-token:${GITHUB_TOKEN}@github.com/".insteadOf "https://github.com/"; \
    fi && \
    git clone --depth 1 https://github.com/layervai/nhp-plugins-passcode.git /tmp/passcode && \
    cd /tmp/passcode && \
    mkdir -p /nhp-server/release/nhp-server/plugins/passcode/etc && \
    mkdir -p /nhp-server/release/nhp-server/templates/passcode && \
    CGO_ENABLED=1 go build -buildmode=plugin -o /nhp-server/release/nhp-server/plugins/passcode/main.so . && \
    cp -r etc/* /nhp-server/release/nhp-server/plugins/passcode/etc/ 2>/dev/null || true && \
    cp -r templates/* /nhp-server/release/nhp-server/templates/passcode/ 2>/dev/null || true && \
    rm -rf /tmp/passcode && \
    git config --global --unset-all url."https://x-access-token:${GITHUB_TOKEN}@github.com/".insteadOf 2>/dev/null || true

# Stage 2: Runtime image
FROM ubuntu:24.04 AS runtime

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && \
    apt-get install -y \
    ca-certificates \
    iptables \
    ipset \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy built binary
COPY --from=builder /nhp-server/release/nhp-server /nhp-server

# Run as non-root user (optional, requires NET_ADMIN capability)
# RUN useradd -r -s /bin/false nhp
# USER nhp

ENTRYPOINT ["/nhp-server/nhp-serverd"]
CMD ["run"]
