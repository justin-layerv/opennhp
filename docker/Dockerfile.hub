# Multi-stage build for the private Connector Hub worker. Customer/application
# traffic is NHP UDP only; the separate TCP port accepts and closes private NLB
# health checks without reading a payload.
FROM golang:1.26.6-bookworm@sha256:116d58cbd88c1297624acc6e967a060012422bacf9930927e23fb719189c6f36 AS builder

WORKDIR /nhp-hub

RUN apt-get -o Acquire::Retries=3 -o Acquire::http::Timeout=30 -o Acquire::https::Timeout=30 update && \
    apt-get -o Acquire::Retries=3 -o Acquire::http::Timeout=30 -o Acquire::https::Timeout=30 install -y \
    make \
    && rm -rf /var/lib/apt/lists/*

COPY nhp/go.mod nhp/go.sum ./nhp/
COPY internalauth/go.mod ./internalauth/
COPY endpoints/go.mod endpoints/go.sum ./endpoints/

RUN cd nhp && go mod download
RUN cd endpoints && go mod download

COPY . .

ENV CGO_ENABLED=0
# Dependency manifests were downloaded above; build only the Hub artifact.
# Avoid the repository-wide init target, whose git clean/tidy work is unrelated
# to this isolated image and cannot run from a copied Git worktree pointer. The
# workflow supplies the exact source SHA explicitly so binary provenance never
# depends on a copied .git directory (a worktree pointer is invalid in-image).
ARG NHP_BUILD_COMMIT_ID
ARG NHP_BUILD_COMMIT_TIME
RUN test -n "$NHP_BUILD_COMMIT_ID" && test -n "$NHP_BUILD_COMMIT_TIME" && \
    make hubd COMMIT_ID="$NHP_BUILD_COMMIT_ID" COMMIT_TIME="$NHP_BUILD_COMMIT_TIME"

FROM ubuntu:26.04@sha256:3131b4cc82a783df6c9df078f86e01819a13594b865c2cad47bd1bca2b7063bb AS runtime

ENV DEBIAN_FRONTEND=noninteractive
# Use the pinned official sources first with one bounded Azure-local recovery
# path for mirror outages. The helper owns update + install, repairs partial
# dpkg state on fallback, and fails if neither source completes the package set.
RUN --mount=type=bind,source=docker/ubuntu-apt-install-with-fallback.sh,target=/usr/local/sbin/ubuntu-apt-install-with-fallback,ro \
    /usr/local/sbin/ubuntu-apt-install-with-fallback \
    ca-certificates \
    libssl3t64 \
    openssl-provider-legacy \
    && dpkg --compare-versions "$(dpkg-query -W -f='${Version}' libssl3t64)" ge 3.5.5-1ubuntu3.2 \
        || { echo "ERROR: libssl3t64 < 3.5.5-1ubuntu3.2"; exit 1; } \
    && rm -rf /var/lib/apt/lists/* \
    && rm -f /usr/bin/pebble && rm -rf /var/lib/pebble

COPY --from=builder /nhp-hub/release/nhp-hub /nhp-hub

# The copied etc/hub.toml is a fail-closed placeholder. Runtime infrastructure
# must overlay /nhp-hub/etc with one task-scoped config volume, run this image's
# `materialize-config` command once as a short-lived root init container, and
# mount the completed file read-only into the long-lived nonroot worker. The
# worker must not receive the init-only key environment variables.
#
# TCP connect-only liveness reads the exact same strict config as the worker and
# derives its target from health_listen_addr. There is deliberately no second
# image-level host/port value, HTTP handler, or health payload.
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
    CMD ["/nhp-hub/nhp-hubd", "healthcheck"]

STOPSIGNAL SIGTERM
USER 65532:65532
ENTRYPOINT ["/nhp-hub/nhp-hubd"]
CMD ["run"]
