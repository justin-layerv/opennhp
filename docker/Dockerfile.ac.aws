# Multi-stage build for NHP Access Controller with embedded Traefik
# For AWS deployment with Let's Encrypt DNS-01 challenge via Route53
#
# Stage 1: Build the NHP AC binary
# Tag participates in the GO_VERSION lockstep (see #1337). Canonical
# source of all locations is .github/workflows/build-and-push.yml's
# env.GO_VERSION block.
FROM golang:1.26.6-bookworm@sha256:116d58cbd88c1297624acc6e967a060012422bacf9930927e23fb719189c6f36 AS builder

WORKDIR /nhp-server

# Install build dependencies.
# -o Acquire::Retries=3 + short timeout so a transient APT mirror
# outage retries instead of failing the whole Docker build. This
# stage uses deb.debian.org (golang:bookworm base) but the flags
# are mirror-agnostic — the runtime stage's ubuntu:26.04 apt calls
# apply the same hardening. Real CI flake: see run 24548987311
# (2026-04-17), archive.ubuntu.com outage in the runtime stage.
# clang + llvm compile the eBPF objects (make ebpf-objects, below);
# libbpf-dev supplies the <bpf/bpf_helpers.h>, <bpf/bpf_core_read.h>,
# and <bpf/bpf_endian.h> headers the eBPF C sources #include (the
# vendored vmlinux.h is in-tree, but those three are angle-bracket
# system includes resolved from /usr/include/bpf/). Without libbpf-dev
# the eBPF compile fails with "bpf/bpf_helpers.h: file not found". This
# whole toolchain lives only in the AC builder stage — docker/Dockerfile.server
# (server/relay) builds via `make serverd`, which never triggers the
# clang-required eBPF path, so clang stays out of the non-AC build deps.
RUN apt-get -o Acquire::Retries=3 -o Acquire::http::Timeout=30 -o Acquire::https::Timeout=30 update && \
    apt-get -o Acquire::Retries=3 -o Acquire::http::Timeout=30 -o Acquire::https::Timeout=30 install -y \
    make \
    clang \
    llvm \
    libbpf-dev \
    && rm -rf /var/lib/apt/lists/*

# Copy dependency files first (better layer caching)
COPY nhp/go.mod nhp/go.sum ./nhp/
# internalauth/ has no go.sum today (pure-stdlib module). When the
# first non-stdlib dep lands, ALSO add `internalauth/go.sum` to
# this COPY — without it, the dep-prefetch layer will succeed via
# go.mod resolution but layer caching will silently drift from the
# actual build (downloads stay reproducible but the cache layer
# stops invalidating on dep-version bumps). Same caveat tracked in
# codeql.yml + dependabot-go-tidy.yml setup-go cache blocks.
COPY internalauth/go.mod ./internalauth/
COPY endpoints/go.mod endpoints/go.sum ./endpoints/

# Download dependencies (cached unless go.mod/go.sum change)
RUN cd nhp && go mod download
RUN cd endpoints && go mod download

# Copy source code
COPY . .

# Build the AC binary plus the eBPF object files.
#
# `ebpf-objects` compiles the eBPF objects with clang/llvm (installed in
# this builder stage above); they ride into the runtime image via the
# `release/nhp-ac` COPY below so the AC's boot-time load path is satisfied
# for a later FilterMode=EBPFXDP flip (eBPF-mode-adoption epic). Today
# FilterMode defaults to 0 (iptables), so the objects ship but stay
# unused — this image change is a runtime no-op until the flip slice.
#
# Goal order matters: `init` runs `git clean -df release` FIRST, so it
# must stay ahead of `acd` and `ebpf-objects` — both populate
# release/nhp-ac/etc/ and a reorder putting init last would wipe their
# output. (The runtime guard below would catch a wiped .o, but only at
# image-build time.)
RUN make init acd ebpf-objects

# Stage 2: Rebuild the current Traefik patch release with fixed Go dependencies.
#
# Traefik v3.6.25 carries the fix for CVE-2026-71327 (Gateway API route identity
# collision allowing cross-namespace backend hijacking) via upstream #13580, and
# ships grpc-go v1.82.1 and golang.org/x/text v0.40.0 in its own go.mod — so it
# also supersedes the x/text v0.39.0 override this stage previously applied for
# CVE-2026-56852. It still pins golang.org/x/mod v0.37.0, however, so this stage
# raises x/mod to v0.40.0 for CVE-2026-56864 and CVE-2026-56865. Go MVS also
# raises x/crypto, x/net, x/text, and x/tools to the compatible versions selected
# by that fixed release.
#
# The Gateway API provider is Kubernetes-only and the AC runs Traefik with the
# file provider alone, so CVE-2026-71327 was not reachable here. It is patched
# rather than ignored because a fix exists, which is what .trivyignore's own
# policy requires. Staying on the 3.6.x line avoids pulling a Traefik minor
# upgrade into the AC edge. The official source release asset is
# SHA256-pinned. The matching upstream commit is fetched only to restore the
# tagged main-module identity in Go build metadata; the release tarball remains
# the source authority, and Go's module checksums protect both explicit security
# floors.
#
# v3.6.25 ships grpc v1.82.1 in its own go.mod. The grpc version assertion below
# therefore checks that upstream has not regressed, while the x/mod and x/text
# assertions fence the security override and its MVS-selected dependency graph.
#
# That also satisfies the condition this stage was built to wait for (an
# upstream 3.6.x embedding x/text >= v0.39.0), so the stage itself can now be
# retired in favour of the published binary. Doing that swaps how the binary is
# obtained, so it is deliberately left for its own change rather than folded
# into a CVE fix.
FROM golang:1.26.6-bookworm@sha256:116d58cbd88c1297624acc6e967a060012422bacf9930927e23fb719189c6f36 AS traefik-builder

WORKDIR /traefik-src

RUN curl -fsSL --retry 3 --retry-delay 5 \
        "https://github.com/traefik/traefik/releases/download/v3.6.25/traefik-v3.6.25.src.tar.gz" \
        -o /tmp/traefik-src.tar.gz \
    && echo "bc72a87f59e9d81f62cf3a44ef34df4fe99aebdc1549e69f864087aff07983b7  /tmp/traefik-src.tar.gz" | sha256sum -c - \
    && tar xzf /tmp/traefik-src.tar.gz --strip-components=1 \
    && git init \
    && git remote add origin https://github.com/traefik/traefik.git \
    && git fetch --depth=1 origin 4b18b24b0b002dcc80e0640c6088a87d813de29a \
    && git reset --mixed 4b18b24b0b002dcc80e0640c6088a87d813de29a \
    && git tag v3.6.25 4b18b24b0b002dcc80e0640c6088a87d813de29a \
    && test "$(git rev-parse HEAD)" = 4b18b24b0b002dcc80e0640c6088a87d813de29a \
    && go mod verify \
    && go get golang.org/x/mod@v0.40.0 \
    && test "$(go list -m -f '{{.Version}}' golang.org/x/crypto)" = v0.55.0 \
    && test "$(go list -m -f '{{.Version}}' golang.org/x/mod)" = v0.40.0 \
    && test "$(go list -m -f '{{.Version}}' golang.org/x/net)" = v0.58.0 \
    && test "$(go list -m -f '{{.Version}}' golang.org/x/text)" = v0.41.0 \
    && test "$(go list -m -f '{{.Version}}' golang.org/x/tools)" = v0.49.0 \
    && go mod verify \
    && CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build \
        -trimpath \
        -buildvcs=true \
        -ldflags "-s -w \
          -X github.com/traefik/traefik/v3/pkg/version.Version=3.6.25 \
          -X github.com/traefik/traefik/v3/pkg/version.Codename=ramequin \
          -X github.com/traefik/traefik/v3/pkg/version.BuildDate=2026-07-31T12:26:41Z" \
        -o /usr/local/bin/traefik ./cmd/traefik \
    && /usr/local/bin/traefik version > /tmp/traefik-version.txt \
    && awk -v want_version=3.6.25 -v want_codename=ramequin \
        '$1 == "Version:" && $2 == want_version { version = 1 } \
         $1 == "Codename:" && $2 == want_codename { codename = 1 } \
         END { exit !(version && codename) }' \
        /tmp/traefik-version.txt \
    && go version -m /usr/local/bin/traefik > /tmp/traefik-build-info.txt \
    && awk -v want=v1.82.1 \
        '$1 == "dep" && $2 == "google.golang.org/grpc" && $3 == want { found = 1 } END { exit !found }' \
        /tmp/traefik-build-info.txt \
    && awk -v want=v0.55.0 \
        '$1 == "dep" && $2 == "golang.org/x/crypto" && $3 == want { found = 1 } END { exit !found }' \
        /tmp/traefik-build-info.txt \
    && awk -v want=v0.40.0 \
        '$1 == "dep" && $2 == "golang.org/x/mod" && $3 == want { found = 1 } END { exit !found }' \
        /tmp/traefik-build-info.txt \
    && awk -v want=v0.58.0 \
        '$1 == "dep" && $2 == "golang.org/x/net" && $3 == want { found = 1 } END { exit !found }' \
        /tmp/traefik-build-info.txt \
    && awk -v want=v0.41.0 \
        '$1 == "dep" && $2 == "golang.org/x/text" && $3 == want { found = 1 } END { exit !found }' \
        /tmp/traefik-build-info.txt \
    && awk \
        '$1 == "mod" && $2 == "github.com/traefik/traefik/v3" && $3 == "v3.6.25+dirty" { module = 1 } \
         $1 == "build" && $2 == "vcs.revision=4b18b24b0b002dcc80e0640c6088a87d813de29a" { revision = 1 } \
         $1 == "build" && $2 == "vcs.modified=true" { modified = 1 } \
         END { exit !(module && revision && modified) }' \
        /tmp/traefik-build-info.txt

# Stage 3: Runtime image with Traefik
FROM ubuntu:26.04@sha256:3131b4cc82a783df6c9df078f86e01819a13594b865c2cad47bd1bca2b7063bb AS runtime

ENV DEBIAN_FRONTEND=noninteractive

# Default AWS_REGION to empty so supervisord's `%(ENV_AWS_REGION)s`
# substitution succeeds when the image is run directly (`docker run`)
# without `-e AWS_REGION=...`. Empty value still trips nhp-acd's
# startup guard, but at the friendly Go-layer error message instead of
# an opaque supervisord config-expansion failure. The prod path doesn't
# run the container — the binary is `docker cp`'d out at boot — so this
# only affects local dev / debugging. Note: traefik's DNS-01 / Route53
# path also reads AWS_REGION via this expansion; running the container
# without `-e AWS_REGION=...` will start traefik in a state where ACME
# DNS challenges can't issue certs (acceptable for local-dev paths
# that don't exercise ACME).
ENV AWS_REGION=""

# Swap archive.ubuntu.com for Canonical's Azure mirror before installing.
# GitHub Actions runners are Azure-hosted, so azure.archive.ubuntu.com is
# geo-local and far faster + more reliable than the general archive that
# serves every CI system on the planet. Three consecutive CI failures on
# 2026-04-17 (runs 24548987311, 24549340621, 24550346283) were caused by
# archive.ubuntu.com either refusing connections or crawling at 3 KB/s —
# the retries/timeout in PR #1083 helped but couldn't recover from that.
#
# azure.archive.ubuntu.com serves both the main archive and security
# updates so one substitution covers every source.list entry.
#
# All runtime apt packages in one layer:
#   ca-certificates, iptables, ipset, curl, file, supervisor — base
#   gettext-base — provides envsubst used by the entrypoint script below
RUN sed -i 's|//archive.ubuntu.com|//azure.archive.ubuntu.com|g; s|//security.ubuntu.com|//azure.archive.ubuntu.com|g' /etc/apt/sources.list.d/ubuntu.sources && \
    grep -q azure.archive.ubuntu.com /etc/apt/sources.list.d/ubuntu.sources || \
        { echo "ERROR: ubuntu.sources mirror substitution failed — file format may have changed"; exit 1; } && \
    apt-get -o Acquire::Retries=3 -o Acquire::http::Timeout=30 -o Acquire::https::Timeout=30 update && \
    apt-get -o Acquire::Retries=3 -o Acquire::http::Timeout=30 -o Acquire::https::Timeout=30 install -y \
    ca-certificates \
    iptables \
    ipset \
    curl \
    file \
    supervisor \
    gettext-base \
    # Pull libssl3t64 + openssl-provider-legacy explicitly so `install` upgrades
    # them from the pinned base's 3.5.5-1ubuntu3 to >= 3.5.5-1ubuntu3.2, which
    # fixes CVE-2026-45447 (openssl PKCS7_verify heap UAF, HIGH). We patch the
    # package in this layer rather than bumping the base digest because the
    # patched ubuntu:26.04 digest is still < the docker dep-age window
    # (min_age_days=14); the apt layer is invisible to that check. Drop this once
    # an age-compliant base digest ships the fix.
    libssl3t64 \
    openssl-provider-legacy \
    # Fail the build loudly if the openssl upgrade didn't land (e.g. a stale
    # mirror still serving 3.5.5-1ubuntu3) — otherwise the image would ship the
    # CVE-2026-45447-vulnerable libssl while the build stays green.
    && dpkg --compare-versions "$(dpkg-query -W -f='${Version}' libssl3t64)" ge 3.5.5-1ubuntu3.2 \
        || { echo "ERROR: libssl3t64 < 3.5.5-1ubuntu3.2 — CVE-2026-45447 not patched"; exit 1; } \
    && rm -rf /var/lib/apt/lists/* \
    # Drop Canonical's Pebble service manager (a stray Go binary the ubuntu
    # base ships in /usr/bin/pebble). We never invoke it — this image runs
    # supervisord over nhp-acd + traefik — and it vendors an old
    # golang.org/x/net + Go stdlib, so Trivy flags a cluster of HIGH CVEs
    # against it (x/net CVE-2026-25680/25681/27136/39821/42502/42506 + stdlib
    # CVE-2026-27145; newer base digests add more). Removing the binary clears
    # the whole gobinary scan target. See .trivyignore.
    && rm -f /usr/bin/pebble && rm -rf /var/lib/pebble

# Install the checksum-pinned Traefik source rebuild from the stage above.
# 3.6.25 is built with Go 1.26.6, which fixes CVE-2026-39822 (os.Root escape
# via a trailing-slash symlink), and fixes CVE-2026-48020 (StripPrefix
# route-level auth bypass),
# CVE-2026-35051 (ForwardAuth X-Forwarded-Prefix spoofing),
# CVE-2026-39858 (forwarded alias spoofing pre-auth bypass), and
# CVE-2026-40912 (StripPrefixRegex Path/RawPath desync auth bypass).
# Also bundles go-jose v4.1.4, go-acme/lego v5.3.1, grpc v1.82.1,
# x/crypto v0.55.0, x/mod v0.40.0, x/net v0.58.0, x/text v0.41.0,
# and otel v1.44.0.
COPY --from=traefik-builder /usr/local/bin/traefik /usr/local/bin/traefik

# Copy built AC binary and scripts.
# The /nhp-ac tree is what the prod boot path extracts via `docker cp`
# (terraform/modules/ac/user_data.sh.tpl) into /opt/layerv/nhp-ac, which
# is the nhp-acd systemd WorkingDirectory. So everything the AC reads at
# a path relative to its cwd must live under /nhp-ac/ in this image.
COPY --from=builder /nhp-server/release/nhp-ac /nhp-ac

# Regression guard: fail the image build loudly if the eBPF objects are
# absent (or empty) from /nhp-ac/etc/ — the path the AC loads them from
# (source of truth: endpoints/ac/ebpf/ebpfegine.go, resolved relative to the
# cwd established by the COPY comment above). A future edit that drops the
# builder's `ebpf-objects` step, or a Makefile change to the EBPF_OBJ_*
# output paths, would otherwise silently ship an image that boot-fails
# the AC the moment FilterMode is flipped to EBPFXDP. `test -s` (not `-f`)
# so a zero-byte / truncated object also fails the guard — a clang failure
# already aborts the earlier `make ... ebpf-objects` step, so this is
# defense-in-depth against a future build that produces an empty file. No
# `|| true` / `2>/dev/null` — the guard exits non-zero and aborts the build.
RUN test -s /nhp-ac/etc/nhp_ebpf_xdp.o && test -s /nhp-ac/etc/tc_egress.o \
    || { echo "ERROR: eBPF object(s) missing or empty in /nhp-ac/etc/ — the AC will boot-fail under FilterMode=EBPFXDP. Did the builder's 'make ... ebpf-objects' step get dropped, did the Makefile EBPF_OBJ_* output paths change, or did the compile emit an empty object? (load path: endpoints/ac/ebpf/ebpfegine.go bpfDir=\"etc\")"; exit 1; }

COPY --from=builder /nhp-server/docker/iptables_defaults_ubuntu.sh /iptables_defaults_ubuntu.sh
COPY --from=builder /nhp-server/docker/iptables_defaults_x86.sh /iptables_defaults_x86.sh

# Select appropriate iptables script based on architecture
RUN if [ "$(uname -m)" = "x86_64" ]; then \
        mv /iptables_defaults_x86.sh /iptables_defaults.sh; \
    else \
        mv /iptables_defaults_ubuntu.sh /iptables_defaults.sh; \
    fi && \
    chmod +x /iptables_defaults.sh && \
    rm -f /iptables_defaults_*.sh

# Create directories
RUN mkdir -p /etc/traefik /acme /var/log/traefik /var/log/nhp-ac

# Create Traefik static configuration for AWS (Let's Encrypt DNS-01)
RUN cat > /etc/traefik/traefik.toml <<'EOF'
# Traefik Static Configuration for NHP AC
# TLS termination with Let's Encrypt DNS-01 via Route53

[global]
  checkNewVersion = false
  sendAnonymousUsage = false

[log]
  level = "INFO"
  filePath = "/var/log/traefik/traefik.log"

[accessLog]
  filePath = "/var/log/traefik/access.log"

[api]
  dashboard = true
  insecure = true

[ping]
  entryPoint = "traefik"

[entryPoints]
  [entryPoints.https]
    address = ":443"
    [entryPoints.https.http.tls]
      certResolver = "letsencrypt"
  [entryPoints.traefik]
    address = ":8080"

[certificatesResolvers.letsencrypt.acme]
  email = "${ACME_EMAIL}"
  storage = "/acme/acme.json"
  caServer = "${ACME_CA_SERVER}"
  [certificatesResolvers.letsencrypt.acme.dnsChallenge]
    provider = "route53"
    delayBeforeCheck = 10
    resolvers = ["1.1.1.1:53", "8.8.8.8:53"]

[providers.file]
  filename = "/etc/traefik/dynamic.toml"
  watch = true
EOF

# Create Traefik dynamic configuration (routes to NHP AC)
RUN cat > /etc/traefik/dynamic.toml <<'EOF'
# Traefik Dynamic Configuration
# Routes to NHP Access Controller

[http.routers]
  [http.routers.nhp-ac]
    rule = "PathPrefix(`/`)"
    service = "nhp-ac"
    entryPoints = ["https"]
    [http.routers.nhp-ac.tls]
      certResolver = "letsencrypt"
      [[http.routers.nhp-ac.tls.domains]]
        main = "${NHP_DOMAIN}"
        sans = ["*.${NHP_DOMAIN}"]

[http.services]
  [http.services.nhp-ac.loadBalancer]
    [[http.services.nhp-ac.loadBalancer.servers]]
      url = "http://127.0.0.1:8888"
EOF

# Create supervisord configuration
RUN cat > /etc/supervisor/conf.d/nhp-ac.conf <<'EOF'
[supervisord]
nodaemon=true
logfile=/var/log/supervisor/supervisord.log
pidfile=/var/run/supervisord.pid

[program:iptables-init]
command=/iptables_defaults.sh
autostart=true
autorestart=false
startsecs=0
priority=1
stdout_logfile=/var/log/supervisor/iptables-init.log
stderr_logfile=/var/log/supervisor/iptables-init-err.log

[program:traefik]
command=/usr/local/bin/traefik --configFile=/etc/traefik/traefik.toml
autostart=true
autorestart=true
priority=10
stdout_logfile=/var/log/supervisor/traefik.log
stderr_logfile=/var/log/supervisor/traefik-err.log
environment=ACME_EMAIL="%(ENV_ACME_EMAIL)s",ACME_CA_SERVER="%(ENV_ACME_CA_SERVER)s",NHP_DOMAIN="%(ENV_NHP_DOMAIN)s",AWS_REGION="%(ENV_AWS_REGION)s"

# nhp-acd hard-fails without AWS_REGION (see endpoints/ac/registration.go,
# issue #1659). The prod path extracts this binary via `docker cp` and runs
# it under systemd, so this supervisord block is build-only — but if anyone
# ever runs the image directly (`docker run`), AWS_REGION must be plumbed
# through here too. Mirrors the traefik block above.
[program:nhp-ac]
command=/nhp-ac/nhp-acd run
autostart=true
autorestart=true
priority=20
stdout_logfile=/var/log/supervisor/nhp-ac.log
stderr_logfile=/var/log/supervisor/nhp-ac-err.log
directory=/nhp-ac
environment=AWS_REGION="%(ENV_AWS_REGION)s"
EOF

# Create entrypoint that processes environment variables
RUN cat > /entrypoint.sh <<'ENTRYPOINT'
#!/bin/bash
set -e

# Substitute environment variables in Traefik config
envsubst < /etc/traefik/traefik.toml > /tmp/traefik.toml && mv /tmp/traefik.toml /etc/traefik/traefik.toml
envsubst < /etc/traefik/dynamic.toml > /tmp/dynamic.toml && mv /tmp/dynamic.toml /etc/traefik/dynamic.toml

# Create ACME storage file if it doesn't exist
if [ ! -f /acme/acme.json ]; then
    touch /acme/acme.json
fi
chmod 600 /acme/acme.json

# Run supervisord
exec /usr/bin/supervisord -c /etc/supervisor/supervisord.conf
ENTRYPOINT
RUN chmod +x /entrypoint.sh

# Expose ports
# 443: HTTPS (Traefik TLS termination)
# 8888: NHP AC API (internal)
# 8080: Traefik dashboard/health (internal)
EXPOSE 443 8888 8080

# Health check on Traefik ping endpoint
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -sf http://localhost:8080/ping || exit 1

# Volume for Let's Encrypt certificates
VOLUME ["/acme"]

ENTRYPOINT ["/entrypoint.sh"]
