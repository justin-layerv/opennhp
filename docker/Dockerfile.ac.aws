# Multi-stage build for NHP Access Controller with embedded Traefik
# For AWS deployment with Let's Encrypt DNS-01 challenge via Route53
#
# Stage 1: Build the NHP AC binary
# Tag participates in the GO_VERSION lockstep (see #1337). Canonical
# source of all locations is .github/workflows/build-and-push.yml's
# env.GO_VERSION block.
FROM golang:1.26.3-bookworm@sha256:252599aeb51ad60b83e4d8821802068127c528c707cb7dd7afd93be057c6011c AS builder

WORKDIR /nhp-server

# Install build dependencies.
# -o Acquire::Retries=3 + short timeout so a transient APT mirror
# outage retries instead of failing the whole Docker build. This
# stage uses deb.debian.org (golang:bookworm base) but the flags
# are mirror-agnostic — the runtime stage's ubuntu:24.04 apt calls
# apply the same hardening. Real CI flake: see run 24548987311
# (2026-04-17), archive.ubuntu.com outage in the runtime stage.
RUN apt-get -o Acquire::Retries=3 -o Acquire::http::Timeout=30 -o Acquire::https::Timeout=30 update && \
    apt-get -o Acquire::Retries=3 -o Acquire::http::Timeout=30 -o Acquire::https::Timeout=30 install -y \
    make \
    clang \
    llvm \
    && rm -rf /var/lib/apt/lists/*

# Copy dependency files first (better layer caching)
COPY nhp/go.mod nhp/go.sum ./nhp/
# internalauth/ has no go.sum today (pure-stdlib module). When the
# first non-stdlib dep lands, ALSO add `internalauth/go.sum` to
# this COPY — without it, the dep-prefetch layer will succeed via
# go.mod resolution but layer caching will silently drift from the
# actual build (downloads stay reproducible but the cache layer
# stops invalidating on dep-version bumps). Same caveat tracked in
# codeql.yml + dependabot-go-tidy.yml setup-go cache blocks.
COPY internalauth/go.mod ./internalauth/
COPY endpoints/go.mod endpoints/go.sum ./endpoints/

# Download dependencies (cached unless go.mod/go.sum change)
RUN cd nhp && go mod download
RUN cd endpoints && go mod download

# Copy source code
COPY . .

# Build the AC
RUN make init acd

# Stage 2: Runtime image with Traefik
FROM ubuntu:26.04@sha256:f3d28607ddd78734bb7f71f117f3c6706c666b8b76cbff7c9ff6e5718d46ff64 AS runtime

ENV DEBIAN_FRONTEND=noninteractive

# Default AWS_REGION to empty so supervisord's `%(ENV_AWS_REGION)s`
# substitution succeeds when the image is run directly (`docker run`)
# without `-e AWS_REGION=...`. Empty value still trips nhp-acd's
# startup guard, but at the friendly Go-layer error message instead of
# an opaque supervisord config-expansion failure. The prod path doesn't
# run the container — the binary is `docker cp`'d out at boot — so this
# only affects local dev / debugging. Note: traefik's DNS-01 / Route53
# path also reads AWS_REGION via this expansion; running the container
# without `-e AWS_REGION=...` will start traefik in a state where ACME
# DNS challenges can't issue certs (acceptable for local-dev paths
# that don't exercise ACME).
ENV AWS_REGION=""

# Swap archive.ubuntu.com for Canonical's Azure mirror before installing.
# GitHub Actions runners are Azure-hosted, so azure.archive.ubuntu.com is
# geo-local and far faster + more reliable than the general archive that
# serves every CI system on the planet. Three consecutive CI failures on
# 2026-04-17 (runs 24548987311, 24549340621, 24550346283) were caused by
# archive.ubuntu.com either refusing connections or crawling at 3 KB/s —
# the retries/timeout in PR #1083 helped but couldn't recover from that.
#
# azure.archive.ubuntu.com serves both the main archive and security
# updates so one substitution covers every source.list entry.
#
# All runtime apt packages in one layer:
#   ca-certificates, iptables, ipset, curl, file, supervisor — base
#   gettext-base — provides envsubst used by the entrypoint script below
RUN sed -i 's|//archive.ubuntu.com|//azure.archive.ubuntu.com|g; s|//security.ubuntu.com|//azure.archive.ubuntu.com|g' /etc/apt/sources.list.d/ubuntu.sources && \
    grep -q azure.archive.ubuntu.com /etc/apt/sources.list.d/ubuntu.sources || \
        { echo "ERROR: ubuntu.sources mirror substitution failed — file format may have changed"; exit 1; } && \
    apt-get -o Acquire::Retries=3 -o Acquire::http::Timeout=30 -o Acquire::https::Timeout=30 update && \
    apt-get -o Acquire::Retries=3 -o Acquire::http::Timeout=30 -o Acquire::https::Timeout=30 install -y \
    ca-certificates \
    iptables \
    ipset \
    curl \
    file \
    supervisor \
    gettext-base \
    && rm -rf /var/lib/apt/lists/*

# Install Traefik v3 with retry logic for GitHub rate limits
# 3.6.16 fixes CVE-2026-35051 (ForwardAuth X-Forwarded-Prefix spoofing),
# CVE-2026-39858 (forwarded alias spoofing pre-auth bypass), and
# CVE-2026-40912 (StripPrefixRegex Path/RawPath desync auth bypass).
# Also bundles go-jose v4.1.4, go-acme/lego v4.35.2, grpc v1.80.0, otel v1.43.0.
ARG TRAEFIK_VERSION=3.6.16
# SHA256 of traefik_v${TRAEFIK_VERSION}_linux_amd64.tar.gz, copied from
# https://github.com/traefik/traefik/releases/download/v${TRAEFIK_VERSION}/traefik_v${TRAEFIK_VERSION}_checksums.txt
# Bump in lockstep with TRAEFIK_VERSION — sha256sum -c will fail the build
# if this drifts from the published artifact.
ARG TRAEFIK_SHA256=3d51f6db1672d571d78c120f536138c11294913dac7932d783bd2052a29d0dc2
RUN set -ex && \
    for i in 1 2 3 4 5; do \
        curl -fsSL --retry 3 --retry-delay 5 \
            "https://github.com/traefik/traefik/releases/download/v${TRAEFIK_VERSION}/traefik_v${TRAEFIK_VERSION}_linux_amd64.tar.gz" \
            -o /tmp/traefik.tar.gz && \
        file /tmp/traefik.tar.gz | grep -q gzip && break || \
        (echo "Attempt $i failed, retrying..." && sleep 10); \
    done && \
    echo "${TRAEFIK_SHA256}  /tmp/traefik.tar.gz" | sha256sum -c - && \
    tar xzf /tmp/traefik.tar.gz -C /usr/local/bin traefik && \
    chmod +x /usr/local/bin/traefik && \
    rm /tmp/traefik.tar.gz

# Copy built AC binary and scripts
COPY --from=builder /nhp-server/release/nhp-ac /nhp-ac
COPY --from=builder /nhp-server/docker/iptables_defaults_ubuntu.sh /iptables_defaults_ubuntu.sh
COPY --from=builder /nhp-server/docker/iptables_defaults_x86.sh /iptables_defaults_x86.sh

# Select appropriate iptables script based on architecture
RUN if [ "$(uname -m)" = "x86_64" ]; then \
        mv /iptables_defaults_x86.sh /iptables_defaults.sh; \
    else \
        mv /iptables_defaults_ubuntu.sh /iptables_defaults.sh; \
    fi && \
    chmod +x /iptables_defaults.sh && \
    rm -f /iptables_defaults_*.sh

# Create directories
RUN mkdir -p /etc/traefik /acme /var/log/traefik /var/log/nhp-ac

# Create Traefik static configuration for AWS (Let's Encrypt DNS-01)
RUN cat > /etc/traefik/traefik.toml <<'EOF'
# Traefik Static Configuration for NHP AC
# TLS termination with Let's Encrypt DNS-01 via Route53

[global]
  checkNewVersion = false
  sendAnonymousUsage = false

[log]
  level = "INFO"
  filePath = "/var/log/traefik/traefik.log"

[accessLog]
  filePath = "/var/log/traefik/access.log"

[api]
  dashboard = true
  insecure = true

[ping]
  entryPoint = "traefik"

[entryPoints]
  [entryPoints.https]
    address = ":443"
    [entryPoints.https.http.tls]
      certResolver = "letsencrypt"
  [entryPoints.traefik]
    address = ":8080"

[certificatesResolvers.letsencrypt.acme]
  email = "${ACME_EMAIL}"
  storage = "/acme/acme.json"
  caServer = "${ACME_CA_SERVER}"
  [certificatesResolvers.letsencrypt.acme.dnsChallenge]
    provider = "route53"
    delayBeforeCheck = 10
    resolvers = ["1.1.1.1:53", "8.8.8.8:53"]

[providers.file]
  filename = "/etc/traefik/dynamic.toml"
  watch = true
EOF

# Create Traefik dynamic configuration (routes to NHP AC)
RUN cat > /etc/traefik/dynamic.toml <<'EOF'
# Traefik Dynamic Configuration
# Routes to NHP Access Controller

[http.routers]
  [http.routers.nhp-ac]
    rule = "PathPrefix(`/`)"
    service = "nhp-ac"
    entryPoints = ["https"]
    [http.routers.nhp-ac.tls]
      certResolver = "letsencrypt"
      [[http.routers.nhp-ac.tls.domains]]
        main = "${NHP_DOMAIN}"
        sans = ["*.${NHP_DOMAIN}"]

[http.services]
  [http.services.nhp-ac.loadBalancer]
    [[http.services.nhp-ac.loadBalancer.servers]]
      url = "http://127.0.0.1:8888"
EOF

# Create supervisord configuration
RUN cat > /etc/supervisor/conf.d/nhp-ac.conf <<'EOF'
[supervisord]
nodaemon=true
logfile=/var/log/supervisor/supervisord.log
pidfile=/var/run/supervisord.pid

[program:iptables-init]
command=/iptables_defaults.sh
autostart=true
autorestart=false
startsecs=0
priority=1
stdout_logfile=/var/log/supervisor/iptables-init.log
stderr_logfile=/var/log/supervisor/iptables-init-err.log

[program:traefik]
command=/usr/local/bin/traefik --configFile=/etc/traefik/traefik.toml
autostart=true
autorestart=true
priority=10
stdout_logfile=/var/log/supervisor/traefik.log
stderr_logfile=/var/log/supervisor/traefik-err.log
environment=ACME_EMAIL="%(ENV_ACME_EMAIL)s",ACME_CA_SERVER="%(ENV_ACME_CA_SERVER)s",NHP_DOMAIN="%(ENV_NHP_DOMAIN)s",AWS_REGION="%(ENV_AWS_REGION)s"

# nhp-acd hard-fails without AWS_REGION (see endpoints/ac/registration.go,
# issue #1659). The prod path extracts this binary via `docker cp` and runs
# it under systemd, so this supervisord block is build-only — but if anyone
# ever runs the image directly (`docker run`), AWS_REGION must be plumbed
# through here too. Mirrors the traefik block above.
[program:nhp-ac]
command=/nhp-ac/nhp-acd run
autostart=true
autorestart=true
priority=20
stdout_logfile=/var/log/supervisor/nhp-ac.log
stderr_logfile=/var/log/supervisor/nhp-ac-err.log
directory=/nhp-ac
environment=AWS_REGION="%(ENV_AWS_REGION)s"
EOF

# Create entrypoint that processes environment variables
RUN cat > /entrypoint.sh <<'ENTRYPOINT'
#!/bin/bash
set -e

# Substitute environment variables in Traefik config
envsubst < /etc/traefik/traefik.toml > /tmp/traefik.toml && mv /tmp/traefik.toml /etc/traefik/traefik.toml
envsubst < /etc/traefik/dynamic.toml > /tmp/dynamic.toml && mv /tmp/dynamic.toml /etc/traefik/dynamic.toml

# Create ACME storage file if it doesn't exist
if [ ! -f /acme/acme.json ]; then
    touch /acme/acme.json
fi
chmod 600 /acme/acme.json

# Run supervisord
exec /usr/bin/supervisord -c /etc/supervisor/supervisord.conf
ENTRYPOINT
RUN chmod +x /entrypoint.sh

# Expose ports
# 443: HTTPS (Traefik TLS termination)
# 8888: NHP AC API (internal)
# 8080: Traefik dashboard/health (internal)
EXPOSE 443 8888 8080

# Health check on Traefik ping endpoint
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -sf http://localhost:8080/ping || exit 1

# Volume for Let's Encrypt certificates
VOLUME ["/acme"]

ENTRYPOINT ["/entrypoint.sh"]
