# Trivy ignore file for vulnerabilities without available fixes
# These are OS-level vulnerabilities in Ubuntu 24.04 that don't have patches yet

# coreutils - low severity, very old CVE
CVE-2016-2781

# curl vulnerabilities - waiting for Ubuntu patches
CVE-2025-0167
CVE-2025-10148
CVE-2025-9086

# gpgv - low priority
CVE-2022-3219

# libgcrypt20 - waiting for Ubuntu patches
CVE-2024-2236

# libpam - waiting for Ubuntu patches
CVE-2025-8941

# openssl/libssl3t64 - waiting for Ubuntu patches
CVE-2024-41996

# login/passwd - waiting for Ubuntu patches
CVE-2024-56433

# tar - waiting for Ubuntu patches
CVE-2025-45582

# libexpat1 - waiting for Ubuntu patches
CVE-2025-66382

# sigstore/timestamp-authority - no fix available yet (v1.2.9 is latest)
CVE-2025-66564

# Go stdlib - published 2026-01-28, after Go 1.24.12 release (2026-01-15)
# Waiting for Go 1.24.13 or 1.25.7
# https://avd.aquasec.com/nvd/cve-2025-61726
CVE-2025-61726

# Go stdlib - archive/zip CPU exhaustion
# https://avd.aquasec.com/nvd/cve-2025-61728
CVE-2025-61728

# Go stdlib - crypto/tls session resumption issue
# https://avd.aquasec.com/nvd/cve-2025-68121
CVE-2025-68121

# Go stdlib - TLS 1.3 handshake issue
# https://avd.aquasec.com/nvd/cve-2025-61730
CVE-2025-61730

# OpenTelemetry Go SDK - PATH hijacking on macOS/Darwin (not exploitable in Linux containers)
# Fixed in our code (PR #560), but Traefik v3.6.9 still bundles otel/sdk < v1.40.0
# https://avd.aquasec.com/nvd/cve-2026-24051
CVE-2026-24051

# docker/cli - Windows-only CLI plugin manager path traversal (CWE-427)
# Not exploitable in Linux containers. Indirect dependency via cosign/sigstore.
# Fixed in docker/cli v29.2.0 (this PR bumps to it), but Trivy DB hasn't registered the fix yet
# https://vulnerability.circl.lu/vuln/cve-2025-15558
CVE-2025-15558
