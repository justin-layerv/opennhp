# LayerV NHP Server Docker Image
# Multi-stage build for minimal production image

FROM golang:1.24.12-alpine AS builder

# Install build dependencies
RUN apk add --no-cache git make gcc musl-dev

# Set working directory
WORKDIR /build

# Copy go mod files first for caching
COPY go.work go.work.sum ./
COPY nhp/go.mod nhp/go.sum ./nhp/
COPY endpoints/go.mod endpoints/go.sum ./endpoints/

# Download dependencies
RUN cd nhp && go mod download
RUN cd endpoints && go mod download

# Copy source code
COPY nhp/ ./nhp/
COPY endpoints/ ./endpoints/

# Build the server
RUN cd endpoints/server/main && \
    CGO_ENABLED=0 GOOS=linux GOARCH=amd64 \
    go build -ldflags="-s -w" -o /build/nhp-serverd .

# Production image
FROM alpine:3.19

# Install runtime dependencies
RUN apk add --no-cache ca-certificates tzdata

# Create non-root user
RUN addgroup -g 1000 nhp && \
    adduser -u 1000 -G nhp -s /bin/sh -D nhp

# Create directories
RUN mkdir -p /etc/nhp /var/log/nhp /var/lib/nhp && \
    chown -R nhp:nhp /etc/nhp /var/log/nhp /var/lib/nhp

# Copy binary
COPY --from=builder /build/nhp-serverd /usr/local/bin/nhp-serverd
RUN chmod +x /usr/local/bin/nhp-serverd

# Switch to non-root user
USER nhp

# Expose NHP protocol port
EXPOSE 62206/udp

# Health check (basic process check)
HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=3 \
    CMD pgrep nhp-serverd || exit 1

# Set working directory
WORKDIR /var/lib/nhp

# Default command
ENTRYPOINT ["/usr/local/bin/nhp-serverd"]
CMD ["run"]
