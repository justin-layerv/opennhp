# ============================================================================
# Go
# ============================================================================

# Binaries
*.exe
*.exe~
*.dll
*.so
*.dylib

# NHP binaries (compiled without extension on Unix)
nhp-server
nhp-acd
nhp-agent
endpoints/nhp-acd
endpoints/nhp-server
endpoints/nhp-agent

# Test binaries
*.test

# Coverage
*.out
coverage.html
coverage.txt

# Go workspace (go.sum should be committed)
go.work
go.work.sum

# Vendor directory (if not vendoring)
# vendor/

# ============================================================================
# Terraform
# ============================================================================

# Local .terraform directories
**/.terraform/

# State files
*.tfstate
*.tfstate.*
*.tfstate.backup

# Plan files
*.tfplan
tfplan
tfplan.*

# Variables files with secrets (but not example files)
*.tfvars.json
*.auto.tfvars
!*.example.tfvars

# Crash logs
crash.log
crash.*.log

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI config
.terraformrc
terraform.rc

# Lock file (commit this for consistent provider versions)
# .terraform.lock.hcl

# Lambda zips (generated by archive_file)
terraform/**/*.zip

# ============================================================================
# IDE / Editors
# ============================================================================

# JetBrains (IntelliJ, GoLand, etc.)
.idea/
*.iml
*.ipr
*.iws
out/

# VSCode
.vscode/
*.code-workspace

# Vim
*.swp
*.swo
*.swn
*~

# Emacs
*~
\#*\#
.#*

# Sublime Text
*.sublime-project
*.sublime-workspace

