* text=auto

* linguist-language=Go

*.c linguist-vendored
*.h linguist-vendored

*.md linguist-documentation=true

# Ensure consistent LF line endings for shell-interpreted files
*.go text eol=lf
*.mod text eol=lf
*.sum text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
Dockerfile* text eol=lf
*.tf text eol=lf
*.tfvars text eol=lf
*.sh text eol=lf
*.tpl text eol=lf
# Packer templates embed shell in `inline` blocks; pin LF so a CRLF file
# (nhp-server-docker.pkr.hcl was wholly CRLF) can't drift the others.
*.hcl text eol=lf
*.pkr.hcl text eol=lf

# qURL v2 admission-wire contract fixtures are byte-sensitive: TestAdmissionWireContract
# hashes the raw bytes of the set (canonicalFixtureSetSHA256), so a CRLF checkout on
# Windows would spuriously break the checksum. Pin LF for these fixtures explicitly.
endpoints/server/staticplugins/qurl/testdata/qurlv2_admission_contract/*.json text eol=lf

# The NHP agent-registration golden vector is byte-sensitive twice over: the
# roundtrip fence pins its sha256 (agentRegFixtureSHA256), and the upstream-drift
# check (scripts/check-agent-reg-vector-drift.sh) byte-compares it against the LF
# raw blob fetched from qurl-conformance. A CRLF checkout would spuriously break
# both. Pin LF explicitly so byte-exactness holds on any runner.
nhp/core/testdata/agent_registration_golden.json text eol=lf
